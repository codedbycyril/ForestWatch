# Copy this file to .env and configure the values on the server.
SECRET_KEY=
RANGER_PASSWORD_HASH=

# Keep false for local HTTP development; set true when served over HTTPS.
SESSION_COOKIE_SECURE=false

# Optional SMS provider settings.
RANGER_PHONE=+254700000000
SMS_SHORTCODE=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# Google Earth Engine & AI Configuration
# Create a Google Cloud Project with Earth Engine API enabled and put its ID here
EE_PROJECT_ID=
# Optional: Earth Engine Asset ID for Mau Forest boundary (e.g. projects/.../assets/mau_boundary)
AOI_ASSET=
# Optional: Earth Engine Asset ID for training points with 'class' attribute (1=forest, 0=non-forest)
TRAINING_ASSET=
